# ============================================================
# AllenVault — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git!
# ============================================================

# --- Telegram ---
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID kamu (dapatkan dengan /myid setelah bot jalan)
# Pisahkan beberapa ID dengan koma: 123456,789012
ALLOWED_USER_IDS=your_telegram_user_id_here

# --- Google Sheets ---
# Spreadsheet ID (bagian URL setelah /d/ dan sebelum /edit)
# Contoh URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path ke file JSON credentials Service Account Google Cloud
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json

# --- Aplikasi ---
# Timezone (lihat: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=Asia/Jakarta

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Database ---
# Path ke file SQLite lokal
DATABASE_PATH=allenvault.db

# --- AI / OCR (untuk Phase 4 nanti) ---
# GEMINI_API_KEY=your_gemini_api_key_here

